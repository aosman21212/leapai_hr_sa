<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Daily check for expiring documents -->
        <record id="ir_cron_check_document_expiry" model="ir.cron">
            <field name="name">HR SA: Check Document Expiry</field>
            <field name="model_id" ref="model_hr_employee_document"/>
            <field name="code">model._cron_check_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
        </record>

        <!-- Sequence for loans -->
        <record id="seq_hr_loan" model="ir.sequence">
            <field name="name">Employee Loan</field>
            <field name="code">hr.loan</field>
            <field name="prefix">LOAN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for warnings -->
        <record id="seq_hr_warning" model="ir.sequence">
            <field name="name">Employee Warning</field>
            <field name="code">hr.warning</field>
            <field name="prefix">WARN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
