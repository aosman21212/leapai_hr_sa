<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══ LIST ══════════════════════════════════════════════════════════ -->
    <record id="view_hr_loan_list" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Loans &amp; Advances"
                  decoration-success="state == 'paid'"
                  decoration-warning="state == 'confirmed'"
                  decoration-danger="state == 'refused'"
                  decoration-info="state == 'approved'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="loan_type"/>
                <field name="date"/>
                <field name="amount"/>
                <field name="installments"/>
                <field name="monthly_installment"/>
                <field name="total_remaining"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'paid'"
                       decoration-warning="state == 'confirmed'"
                       decoration-danger="state == 'refused'"
                       decoration-info="state == 'approved'"
                       decoration-muted="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- ══ FORM ══════════════════════════════════════════════════════════ -->
    <record id="view_hr_loan_form" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Loan / Salary Advance">
                <header>
                    <button name="action_confirm" string="Submit" type="object"
                            invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'confirmed'"
                            class="btn-primary"
                            groups="leapai_hr_sa.group_hr_sa_manager"/>
                    <button name="action_refuse" string="Refuse" type="object"
                            invisible="state not in ('confirmed','approved')"
                            groups="leapai_hr_sa.group_hr_sa_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state not in ('refused')"
                            groups="leapai_hr_sa.group_hr_sa_manager"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,approved,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Employee">
                            <field name="employee_id"/>
                            <field name="department_id" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Loan Details">
                            <field name="loan_type"/>
                            <field name="date"/>
                            <field name="payment_date"/>
                        </group>
                    </group>
                    <group>
                        <group string="Amount">
                            <field name="amount"/>
                            <field name="installments"/>
                            <field name="monthly_installment" readonly="1"/>
                        </group>
                        <group string="Summary" invisible="state == 'draft'">
                            <field name="total_paid" readonly="1"/>
                            <field name="total_remaining" readonly="1"/>
                        </group>
                    </group>
                    <field name="reason" placeholder="Reason for loan / advance request..."/>

                    <notebook invisible="state == 'draft'">
                        <page string="Repayment Schedule" name="schedule">
                            <field name="loan_line_ids" nolabel="1">
                                <list decoration-success="paid" decoration-muted="not paid">
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="paid" widget="boolean_toggle"/>
                                    <field name="paid_date" optional="show"/>
                                    <field name="notes" optional="show"/>
                                    <button name="action_mark_paid" string="Mark Paid"
                                            type="object" icon="fa-check-circle"
                                            invisible="paid"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ══ ACTION ════════════════════════════════════════════════════════ -->
    <record id="action_hr_loan" model="ir.actions.act_window">
        <field name="name">Loans &amp; Advances</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Loan or Salary Advance</p>
            <p>Manage employee loans and advances with repayment schedules.</p>
        </field>
    </record>

    <!-- My loans (employee view) -->
    <record id="action_hr_loan_my" model="ir.actions.act_window">
        <field name="name">My Loans</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('employee_id.user_id', '=', uid)]</field>
        <field name="context">{'search_default_my_loans': 1}</field>
    </record>

</odoo>
