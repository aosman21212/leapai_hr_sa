<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Module Category Privilege -->
    <record model="res.groups.privilege" id="res_groups_privilege_hr_sa">
        <field name="name">HR Saudi Arabia</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <!-- HR SA User -->
    <record id="group_hr_sa_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_sa"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Can view and manage own HR Saudi records.</field>
    </record>

    <!-- HR SA Manager -->
    <record id="group_hr_sa_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_hr_sa"/>
        <field name="implied_ids" eval="[(4, ref('leapai_hr_sa.group_hr_sa_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Full access to all HR Saudi features and configuration.</field>
    </record>

</odoo>
